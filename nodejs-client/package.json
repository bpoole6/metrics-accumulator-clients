{
  "name": "metrics-accumulator-client",
  "version": "1.1.5",
  "description": "A nodejs client for metrics accumulator",
  "main": "./dist/cjs/client.js",
  "module": "./dist/esm/client.js",
  "types": "./dist/cjs/client.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/client.js",
      "require": "./dist/cjs/client.js",
      "types": "./dist/cjs/client.d.ts"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "npm run build:esm && npm run build:cjs",
    "upload": "npm version patch && npm publish"
  },
  "private": false,
  "dependencies": {
    "@types/node": "^22.5.0",
    "axios": "^1.7.5",
    "prom-client": "^11.5.3",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "homepage": "https://github.com/bpoole6/metrics-accumulator-clients/tree/main/nodejs-client",
  "repository": "https://github.com/bpoole6/metrics-accumulator-clients/tree/main/nodejs-client",
  "keywords": [
    "metrics",
    "accumulator",
    "prometheus",
    "aggregation",
    "pushgateway"
  ]
}
